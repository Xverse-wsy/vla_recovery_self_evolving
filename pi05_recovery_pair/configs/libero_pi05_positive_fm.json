    "image_cosine": 0.007,
    "max_candidates": 50
  },
  "pairing": {
    "position_m": 0.01,
    "rotation_deg": 5.0,
    "proprio_rms": 0.1,
    "image_cosine": 0.002,
    "max_candidates": 50
  }
}
