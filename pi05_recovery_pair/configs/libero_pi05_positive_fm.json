{
  "horizon": 10,
  "action_dim": 32,
  "environment_action_dim": 7,
  "native_control_hz": 20,
  "flow_steps": 3,
  "integrator": "euler",
  "learning_rate": 1e-05,
  "gradient_clip": 1.0,
  "lambda_push": 0.1,
  "eta": 0.0,
  "eta_warmup_fraction": 0.1,
  "fm_batch": 64,
  "pair_batch": 0,
  "vla_fraction": 0.75,
  "fm_micro_batch": 1,
  "pair_micro_batch": 1,
  "max_episode_reuses": 50,
  "fm_only_updates": 100,
  "min_pair_steps": 3,
  "identical_action_tolerance": 0.0001,
